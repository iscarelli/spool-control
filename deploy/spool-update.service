[Unit]
Description=Spool Control self-update (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Roda como root: resolve a última release publicada no GitHub e atualiza.
# Disparado pelo spool-update.path (o app, não-root, só escreve o flag
# /opt/spool-control/data/.update-requested). Apaga o flag ANTES de atualizar —
# isso re-arma o .path observer e evita loop. Nenhum argumento vem da web.
ExecStartPre=/bin/rm -f /opt/spool-control/data/.update-requested
ExecStart=/usr/bin/env bash /opt/spool-control/deploy/update-lxc.sh --latest-release
StandardOutput=journal
StandardError=journal
