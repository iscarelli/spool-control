[Unit]
Description=Spool Control
After=network.target

[Service]
User=spool
WorkingDirectory=/opt/spool-control
Environment=HOME=/tmp
EnvironmentFile=/opt/spool-control/spool.env
ExecStart=/opt/spool-control/.venv/bin/gunicorn \
    --config /opt/spool-control/deploy/gunicorn.conf.py \
    app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
